# Proxic Arena — environment template (PHASE_01 §1.45).
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that
# way (§1.46): no real secret belongs in this file or in the
# repository. Every value below is a placeholder, and the server
# refuses to start in production while a secret is unset or still
# holds a placeholder.

APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- HTTP ---------------------------------------------------------
PROXIC_HOST=0.0.0.0
PROXIC_PORT=8080
# Built Vite output served by Ktor in production (§1.27).
PROXIC_STATIC_ROOT=frontend/dist
PROXIC_DATA_ROOT=data
PUBLIC_BASE_URL=https://proxic.barnflix.net

# --- Database -----------------------------------------------------
POSTGRES_DB=proxic
POSTGRES_USER=proxic
POSTGRES_PASSWORD=changeme
DATABASE_HOST=postgres
DATABASE_PORT=5432
PROXIC_DATABASE_URL=jdbc:postgresql://postgres:5432/proxic

# --- Sessions -----------------------------------------------------
# Generate per deployment, never reuse the placeholder:
#   openssl rand -hex 32
PROXIC_SESSION_SECRET=changeme

# Send session cookies with the Secure attribute. Leave this TRUE for
# any deployment reachable over HTTPS, which is every real one: the
# Cloudflare tunnel terminates TLS.
#
# It is set to false in docker-compose.local.yml only, because a
# browser will not KEEP a Secure cookie delivered over plain HTTP --
# a local stack would appear to sign you in and then not know you.
# Setting it false in production would send session cookies in clear
# text (PHASE_03 §3.23).
PROXIC_SECURE_COOKIES=true

# Accounts are by invitation (spec 0014): an administrator invites an
# email address from the Admin page, and the person chooses their own
# username and password. The first administrator is still created with
# arena-admin inside the container (§3.58, §3.106):
#   docker compose exec arena-server /app/bin/arena-admin create <name> --admin

# --- Invitation email (spec 0014, all optional) -------------------
# Any ordinary email account over SMTP. Left empty, the Admin page gives
# you the invitation link to send yourself. Examples:
#   Gmail: host smtp.gmail.com, port 587, starttls, your address as the
#          username, and an APP PASSWORD (Google Account > Security >
#          App passwords), never your normal password.
#   A sending service on your domain: its SMTP host, port and key.
PROXIC_SMTP_HOST=
PROXIC_SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
PROXIC_SMTP_SECURITY=starttls
PROXIC_SMTP_USERNAME=
PROXIC_SMTP_PASSWORD=
# Who the invitation comes from, e.g. Proxic Arena <you@gmail.com>
PROXIC_SMTP_FROM=

# --- Forge runtime ------------------------------------------------
# The pinned commit lives in server BuildInfo.kt; it is NOT duplicated
# here (§1.25). This points at the built worker artifact only.
FORGE_HOME=/opt/forge
PROXIC_FORGE_WORKER_JAR=/opt/proxic/forge-worker.jar

# --- Cloudflare edge (§1.48) --------------------------------------
# Supplied by the Unraid/Docker environment in production.
CLOUDFLARE_TUNNEL_TOKEN=changeme
