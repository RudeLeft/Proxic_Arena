# Proxic Arena — environment template (PHASE_01 §1.45).
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that
# way (§1.46): no real secret belongs in this file or in the
# repository. Every value below is a placeholder. In production the
# server refuses to start while PROXIC_SESSION_SECRET is unset or still
# a placeholder (changeme and the like); POSTGRES_PASSWORD is not
# checked that way, so scripts/unraid-setup.sh generates it.
#
# Compose reads this file for ITS variables: the server container gets
# only the settings docker-compose.yml lists under arena-server (the
# database, the session secret, email, idle rooms), and the image sets
# its own paths, host and port. The HTTP and Forge lines below reach no
# container; they name what a run outside Docker reads from its own
# environment (the README exports them, with absolute paths). Nor do
# APP_ENV (compose sets production), PROXIC_DATABASE_URL (compose builds
# its own from POSTGRES_DB) and PROXIC_SECURE_COOKIES (the base compose
# file leaves the server's default, true; the local and CI files set
# false).

APP_ENV=development
# Passed to the server, but logging is INFO whatever it says
# (server/src/main/resources/logback.xml).
LOG_LEVEL=INFO

# --- HTTP ---------------------------------------------------------
PROXIC_HOST=0.0.0.0
PROXIC_PORT=8080
# Built Vite output served by Ktor in production (§1.27).
PROXIC_STATIC_ROOT=frontend/dist
PROXIC_DATA_ROOT=data
# The address invitation links use and the sign-in origin check accepts.
# Not passed by the compose file; the server's default is this address.
PUBLIC_BASE_URL=https://proxic.barnflix.net

# --- Database -----------------------------------------------------
POSTGRES_DB=proxic
POSTGRES_USER=proxic
POSTGRES_PASSWORD=changeme
PROXIC_DATABASE_URL=jdbc:postgresql://postgres:5432/proxic

# --- Sessions -----------------------------------------------------
# Generate per deployment, never reuse the placeholder:
#   openssl rand -hex 32
PROXIC_SESSION_SECRET=changeme

# Send session cookies with the Secure attribute. Leave this TRUE for
# any deployment reachable over HTTPS, which is every real one: the
# Cloudflare tunnel terminates TLS.
#
# The compose files set it themselves: false in docker-compose.local.yml
# and docker-compose.ci.yml (plain HTTP on the machine itself), because a
# browser will not KEEP a Secure cookie delivered over plain HTTP --
# a local stack would appear to sign you in and then not know you.
# Setting it false in production would send session cookies in clear
# text (PHASE_03 §3.23).
PROXIC_SECURE_COOKIES=true

# Accounts are by invitation (spec 0014): an administrator invites an
# email address from the Admin page, and the person chooses their own
# username and password. The first administrator is still created with
# arena-admin inside the container (§3.58, §3.106):
#   docker compose exec arena-server /app/bin/arena-admin create <name> --admin

# --- Email: invitations and password resets (specs 0014, 0026) ----
# Any ordinary email account over SMTP, all optional. The Admin page's
# Email tab, once saved, wins over these; these are the fallback. With
# neither set, the Admin page gives you the invitation link to send
# yourself. Examples:
#   Gmail: host smtp.gmail.com, port 587, starttls, your address as the
#          username, and an APP PASSWORD (Google Account > Security >
#          App passwords), never your normal password.
#   A sending service on your domain: its SMTP host, port and key.
PROXIC_SMTP_HOST=
PROXIC_SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
PROXIC_SMTP_SECURITY=starttls
PROXIC_SMTP_USERNAME=
PROXIC_SMTP_PASSWORD=
# Who the invitation comes from, e.g. Proxic Arena <you@gmail.com>
PROXIC_SMTP_FROM=

# --- Idle rooms (spec 0054, all optional) ------------------------
# How long a room in the lobby may sit, in minutes. A room with a game
# in it is never closed by these.
#   ALONE: nothing happening while the host is by themselves
#   TOGETHER: nothing happening once a second player is in it
#   AWAY: a host offline this long closes the room; a guest offline this
#         long leaves it; in a game, the player still there may end it
#   WARNING: how long before an idle close the room says so
PROXIC_ROOM_ALONE_MINUTES=30
PROXIC_ROOM_TOGETHER_MINUTES=120
PROXIC_AWAY_MINUTES=10
PROXIC_ROOM_WARNING_MINUTES=5

# --- Forge runtime ------------------------------------------------
# The pinned commit lives in forge-pin.properties; it is NOT duplicated
# here (§1.25). The built worker and Forge's res/ folder, relative to the
# repository, for a run outside Docker; the image sets its own
# (/app/forge/forge-worker.jar, /app/forge/res).
PROXIC_FORGE_WORKER_JAR=forge-worker/target/forge-worker-0.1.0.jar
PROXIC_FORGE_RES=third_party/forge/forge-gui/res

# --- Cloudflare edge (§1.48) --------------------------------------
# Only for the stack's own `edge` tunnel, which is unused live (the
# tunnel runs outside the stack; scripts/unraid-setup.sh empties this).
CLOUDFLARE_TUNNEL_TOKEN=changeme
