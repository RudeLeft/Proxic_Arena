<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- requestId comes from Ktor's CallId MDC (PHASE_01 §1.43),
                 so a log line can be traced to a request and later to a
                 connection, session, player and match. -->
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Netty is chatty at INFO and drowns everything useful. -->
    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor.server.engine" level="WARN"/>
</configuration>
